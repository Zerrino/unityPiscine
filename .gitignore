# === Unity generated folders ===
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Autogenerated by Unity for user-specific settings
UserSettings/
# Unity Cache Server (local)
/Library/PackageCache/

# === Visual Studio / IDEs ===
.vscode/
.vs/
*.csproj
*.pidb
*.suo
*.user
*.userprefs
*.unityproj
*.sln
*.sdf
*.dbproj
*.VC.db
.idea/
*.iml

# === OS files ===
.DS_Store
Thumbs.db

# === Crash / profiler / generated files ===
sysinfo.txt
*.stacktrace
*.log

# === Build artifacts ===
*.apk
*.aab
*.exe
*.app
*.xcodeproj/*
!*/ProjectSettings/ # keep ProjectSettings tracked, but ignore generated Xcode project files
*.xcworkspace
*.xcuserdata

# === Compression / packages / temp assets ===
*.unitypackage
*.tmp
*.temp

# === Keystore / secrets ===
# Ignore Android keystores (keep your signing keys safe)
*.keystore
*.jks
# If you keep keys elsewhere, remove the above or whitelist the file explicitly.

# === Large or generated binary caches (optional) ===
# Uncomment if you want to ignore user-specific Asset Store cache
# Assets/AssetStoreTools*

# === Keep these tracked ===
# Do NOT ignore: Assets/ and ProjectSettings/ and all .meta files
# (Unity needs .meta files for GUIDs and references)

# === Optional: Git LFS hints (not part of .gitignore) ===
# Consider using Git LFS for large binary assets: PSD, TIFF, WAV, FBX, etc.
# Example: git lfs track "*.psd" "*.psb" "*.tga" "*.png" "*.fbx" "*.wav"
